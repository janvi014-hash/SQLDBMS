CREATE TABLE Student(
    Student_ID INT PRIMARY KEY,
    Name VARCHAR(50),
    Age INT
);

INSERT INTO Student VALUES
(101,'Janvi',20);

START TRANSACTION;

INSERT INTO Student VALUES
(102,'Rahul',21);

ROLLBACK;

START TRANSACTION;

INSERT INTO Student VALUES
